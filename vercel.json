{
  "version": 2,
  "installCommand": "npm install && npm install --prefix server --omit=dev",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/agent",
      "destination": "/api/agent.mjs"
    },
    {
      "source": "/api/agent/:path*",
      "destination": "/api/agent.mjs"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    }
  ],
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300
    }
  }
}
